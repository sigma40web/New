{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/series-blueprint.schema.json",
  "title": "Series Blueprint",
  "description": "Top-level plan with committed ending and endgame requirements (FR-3.2).",
  "type": "object",
  "required": [
    "project_id",
    "version",
    "story_promise",
    "reader_fantasy",
    "main_conflict",
    "protagonist_arc",
    "ending",
    "endgame_requirements",
    "seasons"
  ],
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pinned": {
      "$ref": "common.schema.json#/$defs/versionRef"
    },
    "story_promise": {
      "type": "string"
    },
    "reader_fantasy": {
      "type": "string"
    },
    "main_conflict": {
      "type": "string"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protagonist_arc": {
      "$ref": "#/$defs/characterArc"
    },
    "character_arcs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/characterArc"
      }
    },
    "relationship_arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_entity_id",
          "to_entity_id",
          "start",
          "end",
          "milestones"
        ],
        "additionalProperties": false,
        "properties": {
          "from_entity_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "to_entity_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "milestones": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/milestone"
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "progression_arc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system_summary": {
          "type": "string"
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/milestone"
          }
        },
        "cadence_chapters": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mysteries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer_proposition_id",
          "reveal_window"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string"
          },
          "answer_proposition_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "reveal_window": {
            "$ref": "#/$defs/chapterWindow"
          },
          "clue_plan": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "foreshadowing_register": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "description": "Promise ids with status=planned"
    },
    "red_herrings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "ending": {
      "type": "object",
      "required": [
        "type",
        "final_state_assertions"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "happy",
            "bittersweet",
            "open",
            "tragic"
          ]
        },
        "summary": {
          "type": "string"
        },
        "final_state_assertions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "endgame_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "knowledge",
              "relationship",
              "promise_paid",
              "progression"
            ]
          },
          "target_ref": {
            "type": "string",
            "description": "proposition/entity/promise id when applicable"
          },
          "planned_in_arc_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "unplanned",
              "planned",
              "satisfied"
            ]
          }
        }
      }
    },
    "seasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "title",
          "objective",
          "chapter_range_est"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "thesis": {
            "type": "string"
          },
          "entry_state": {
            "type": "string"
          },
          "exit_state": {
            "type": "string"
          },
          "chapter_range_est": {
            "$ref": "#/$defs/chapterWindow"
          },
          "promise_ids_opened": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "promise_ids_paid": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          }
        }
      }
    },
    "hard_requirement_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "bound_to"
        ],
        "additionalProperties": false,
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "bound_to": {
            "type": "string",
            "description": "season/arc ref or 'all'"
          }
        }
      }
    },
    "pacing": {
      "type": "object",
      "description": "Pacing map (ADR-0056): arcs of 8–30 chapters and one rhythm slot per chapter, produced per season by pacing_designer and validated by the workflow.",
      "required": [
        "arcs",
        "chapters"
      ],
      "additionalProperties": false,
      "properties": {
        "arcs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ordinal",
              "season_ordinal",
              "title",
              "kind",
              "from",
              "to",
              "purpose",
              "climax_chapter",
              "focus_characters"
            ],
            "additionalProperties": false,
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "season_ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "introduction",
                  "daily",
                  "incident",
                  "exam",
                  "tournament",
                  "dungeon",
                  "conflict",
                  "romance",
                  "mystery",
                  "war",
                  "climax"
                ]
              },
              "from": {
                "type": "integer",
                "minimum": 1
              },
              "to": {
                "type": "integer",
                "minimum": 1
              },
              "purpose": {
                "type": "string"
              },
              "climax_chapter": {
                "type": "integer",
                "minimum": 1
              },
              "focus_characters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "chapter_no",
              "arc_ordinal",
              "role",
              "tension",
              "beat",
              "thread",
              "payoff",
              "frustration",
              "hook"
            ],
            "additionalProperties": false,
            "properties": {
              "chapter_no": {
                "type": "integer",
                "minimum": 1
              },
              "arc_ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "hook",
                  "setup",
                  "daily",
                  "buildup",
                  "foreshadow",
                  "incident",
                  "confrontation",
                  "climax",
                  "aftermath",
                  "reward",
                  "relationship",
                  "twist",
                  "rest"
                ]
              },
              "tension": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "beat": {
                "type": "string",
                "minLength": 1
              },
              "thread": {
                "type": "string",
                "enum": [
                  "main",
                  "growth",
                  "romance",
                  "mystery",
                  "rival",
                  "daily",
                  "world"
                ]
              },
              "payoff": {
                "type": "string",
                "enum": [
                  "cider",
                  "reveal",
                  "emotion",
                  "growth",
                  "humor",
                  "none"
                ]
              },
              "frustration": {
                "type": "boolean"
              },
              "hook": {
                "type": "string",
                "enum": [
                  "cliffhanger",
                  "reveal",
                  "decision",
                  "arrival_of_threat",
                  "emotional_peak",
                  "quiet_ominous"
                ]
              },
              "focus_character": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "characterArc": {
      "type": "object",
      "required": [
        "entity_id",
        "start_state",
        "end_state",
        "turning_points"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "start_state": {
          "type": "string"
        },
        "end_state": {
          "type": "string"
        },
        "turning_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/milestone"
          },
          "minItems": 1
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": [
        "description",
        "window"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/chapterWindow"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "realized",
            "unrealized"
          ]
        }
      }
    },
    "chapterWindow": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
