{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/chapter-contract.schema.json",
  "title": "Chapter Contract",
  "description": "Structured specification a chapter must satisfy to be accepted (docs/03-story-planning/02, ADR-0013).",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "chapter_number",
    "version",
    "arc_id",
    "status",
    "pinned",
    "purpose",
    "must_happen",
    "must_not_happen",
    "pov",
    "participants",
    "locations",
    "story_time",
    "timeline_id",
    "knowledge_deltas",
    "state_deltas",
    "relationship_deltas",
    "setups",
    "payoffs",
    "emotional_movement",
    "conflict",
    "local_satisfaction",
    "ending_state",
    "hook",
    "opening",
    "scene_count",
    "dialogue_density_target",
    "continuity_risks",
    "continuity_anchors",
    "knowledge_guards",
    "acceptance_criteria",
    "length_target",
    "narrative_identity_version_id",
    "active_constraints_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "chapter_number": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "arc_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "minor_arc_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "season_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "beat_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pinned": {
      "$ref": "common.schema.json#/$defs/versionRef"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validated",
        "locked",
        "stale",
        "superseded",
        "realized"
      ],
      "description": "Contract lifecycle (ADR-0037): draft → validated (deterministic + plan validators) → locked (approved by human/policy and frozen for production; the API verb is contract:approve) → realized (chapter accepted) | stale (material dependency changed) | superseded (edited/regenerated)."
    },
    "stale_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string",
      "maxLength": 80,
      "description": "Episode title shown to readers (e.g. Korean 회차 제목); optional (ADR-0057)."
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "reader_experience": {
      "type": "string"
    },
    "arc_objective_contribution": {
      "type": "string"
    },
    "must_happen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "description",
          "verifiable_by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "event",
              "revelation",
              "decision",
              "progression",
              "relationship",
              "comedic_beat",
              "required_scene"
            ]
          },
          "description": {
            "type": "string"
          },
          "proposition_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "requirement_id": {
            "type": "string",
            "description": "Spec requirement if user-mandated"
          },
          "verifiable_by": {
            "type": "string",
            "enum": [
              "extraction",
              "judge",
              "lexical_marker",
              "human"
            ]
          },
          "marker_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "must_not_happen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "spec",
              "arc",
              "local",
              "content_restriction"
            ]
          },
          "requirement_id": {
            "type": "string"
          },
          "lexical_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "hard_requirement_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_constraints_ref": {
      "type": "object",
      "required": [
        "id",
        "content_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "content_hash": {
          "type": "string"
        },
        "token_count": {
          "type": "integer"
        }
      },
      "description": "Compiled, scope-filtered Active Constraint Set for this chapter (ADR-0033)"
    },
    "pov": {
      "type": "object",
      "required": [
        "character_id",
        "person"
      ],
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "person": {
          "type": "string",
          "enum": [
            "first",
            "third_limited",
            "third_omniscient"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scene_no",
              "character_id"
            ],
            "additionalProperties": false,
            "properties": {
              "scene_no": {
                "type": "integer"
              },
              "character_id": {
                "$ref": "common.schema.json#/$defs/uuid"
              }
            }
          }
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "character_id",
          "role_in_chapter",
          "on_page"
        ],
        "additionalProperties": false,
        "properties": {
          "character_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "role_in_chapter": {
            "type": "string",
            "enum": [
              "protagonist",
              "antagonist",
              "ally",
              "foil",
              "cameo",
              "love_interest",
              "mentor",
              "comic_relief"
            ]
          },
          "on_page": {
            "type": "boolean"
          }
        }
      }
    },
    "mentioned_only": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "story_time": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "common.schema.json#/$defs/storyClock"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/storyClock"
        },
        "elapsed_since_previous": {
          "type": "string"
        }
      }
    },
    "timeline_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "knowledge_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "knower",
          "from_stance",
          "to_stance",
          "how"
        ],
        "additionalProperties": false,
        "properties": {
          "knower": {
            "$ref": "common.schema.json#/$defs/knowerRef"
          },
          "proposition_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "new_proposition": {
            "type": "string"
          },
          "from_stance": {
            "$ref": "common.schema.json#/$defs/stance"
          },
          "to_stance": {
            "$ref": "common.schema.json#/$defs/stance"
          },
          "how": {
            "type": "string",
            "description": "Channel: witnessed/told by X/inferred…"
          },
          "channel_kind": {
            "type": "string",
            "enum": [
              "witnessed",
              "told",
              "inferred",
              "read",
              "overheard",
              "deduced",
              "remembered",
              "prior_loop_memory",
              "source_story"
            ]
          },
          "informer_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        },
        "anyOf": [
          {
            "required": [
              "proposition_id"
            ]
          },
          {
            "required": [
              "new_proposition"
            ]
          }
        ]
      }
    },
    "state_deltas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateDelta"
      }
    },
    "relationship_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_id",
          "to_id",
          "axis",
          "direction"
        ],
        "additionalProperties": false,
        "properties": {
          "from_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "to_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "axis": {
            "type": "string",
            "enum": [
              "trust",
              "affection",
              "respect",
              "hostility",
              "dependency",
              "type"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "change"
            ]
          },
          "magnitude": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "new_type": {
            "type": "string"
          },
          "address_term_change": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "register_change": {
            "$ref": "common.schema.json#/$defs/dialogueRegister",
            "description": "Abstract register after the change; rendered in English by the writer"
          }
        }
      }
    },
    "introduces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "location",
              "organization",
              "item",
              "ability",
              "term",
              "proposition"
            ]
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "setups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/promiseTouch"
      }
    },
    "payoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/promiseTouch"
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "milestone_id": {
          "type": "string"
        },
        "magnitude": {
          "type": "string",
          "enum": [
            "minor",
            "major"
          ]
        },
        "mechanism": {
          "type": "string"
        }
      }
    },
    "emotional_movement": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string"
        },
        "peak": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "conflict": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "external",
            "internal",
            "interpersonal",
            "social"
          ]
        },
        "description": {
          "type": "string"
        },
        "reversal": {
          "type": "string"
        }
      }
    },
    "local_satisfaction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "$ref": "narrative-identity.schema.json#/$defs/payoffType"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "ending_state": {
      "type": "string"
    },
    "hook": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "narrative-identity.schema.json#/$defs/endingType"
        },
        "description": {
          "type": "string"
        },
        "question_raised": {
          "type": "string"
        }
      }
    },
    "opening": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "narrative-identity.schema.json#/$defs/openingType"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "scene_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "dialogue_density_target": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "monologue_density_target": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "length_target": {
      "$ref": "common.schema.json#/$defs/lengthTarget"
    },
    "narrative_identity_version_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "tone_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "related_fact_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "continuity_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "statement": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidenceRef"
            }
          }
        }
      }
    },
    "knowledge_guards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "character_id",
          "must_not_know_proposition_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "character_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "must_not_know_proposition_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "minItems": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canon_ok": {
          "type": "boolean"
        },
        "plan_ok": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "issue.schema.json"
          }
        },
        "validated_at_canon_version": {
          "type": "integer"
        },
        "narrative_ok": {
          "type": "boolean"
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "deterministic",
              "judge",
              "human"
            ]
          },
          "description": {
            "type": "string"
          },
          "check_ref": {
            "type": "string",
            "description": "rule id / evaluator role / criterion id"
          },
          "threshold": {
            "type": "number"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "scene-plan.schema.json"
      }
    }
  },
  "$defs": {
    "stateDelta": {
      "type": "object",
      "required": [
        "entity_id",
        "attribute",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "attribute": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "from": {},
        "to": {},
        "when_in_chapter": {
          "type": "string",
          "enum": [
            "early",
            "middle",
            "late"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "promiseTouch": {
      "type": "object",
      "required": [
        "promise_id",
        "how"
      ],
      "additionalProperties": false,
      "properties": {
        "promise_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "how": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "open",
            "advance",
            "pay"
          ]
        }
      }
    }
  }
}
